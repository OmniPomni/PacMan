cabal-version:      2.4
name:               pacman
version:            0.1.0.0
synopsis:           Pac-Man in Haskell using Gloss
license:            NONE
author:             Max Haijes, Anass Zaoujal
build-type:         Simple

executable pacman
    main-is:          Main.hs
    other-modules:
        Model
        View
        Controller
        Controller.Player
        Controller.Ghost
        Levels
    hs-source-dirs:   app src
    build-depends:
        base >= 4.14 && < 5
        , gloss
        , random
        , bytestring
        , directory
        , filepath
    default-language: Haskell2010
    ghc-options:      -Wall
